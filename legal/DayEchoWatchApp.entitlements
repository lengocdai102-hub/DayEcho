<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  DayEcho Watch App 的 entitlements

  ★ App Group：与 iOS 主 App 共享容器 ★

  Watch App 录制的音频分段最终落到共享目录，
  iOS 主 App 从同一目录读取 ⇒ 两侧必须指向同一个 App Group。

  ★ 为什么 Watch 侧也需要 App Group ★

  目前 Watch → iPhone 主要靠 WatchConnectivity 传输（不走文件）。
  但 V2 的「录音段先在 Watch 落盘、再由主 App 取走」路径需要共享目录；
  并且 App Group 让 Watch 与主 App 能共享同一份索引/配置，
  避免两端各自维护一份状态导致不一致。

  ★ 免费账号的限制同 iOS 侧 ★
  Personal Team 下带 app-group 的 entitlements 无法签名，
  Watch 侧会退回本地沙盒，功能不受影响（传输走 WatchConnectivity）。
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.dayecho.app.H98V6YZ5QL</string>
	</array>
</dict>
</plist>
